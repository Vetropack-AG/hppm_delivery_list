<mvc:View controllerName="zvgt.hppm.delivery_list.controller.Main" 
	xmlns:mvc="sap.ui.core.mvc"  
	xmlns:core="sap.ui.core"
	xmlns="sap.m" 
	xmlns:smartFilterBar="sap.ui.comp.smartfilterbar" 
	xmlns:smartTable="sap.ui.comp.smarttable" 
	displayBlock="true">
	<Page showHeader="false" floatingFooter="false">
		<content>
			
			<smartFilterBar:SmartFilterBar 
				id="smartFilterBar" 
				entitySet="DeliveryHeadSet" 
				persistencyKey="DELIVERY_LIST_FILTERBAR"
				showFilterConfiguration="true">
				
				<smartFilterBar:controlConfiguration>
					<smartFilterBar:ControlConfiguration label="{i18n>main.shipment}" key="DeliveryKey" visibleInAdvancedArea="true" hasValueHelpDialog="true" />
						<smartFilterBar:ControlConfiguration key="DeliveryDate" visibleInAdvancedArea="true" index="2" 
						conditionType="sap.ui.comp.config.condition.DateRangeType"/>
					<smartFilterBar:ControlConfiguration key="TruckNumber" visibleInAdvancedArea="true" hasValueHelpDialog="true"  />
					<smartFilterBar:ControlConfiguration key="CustomerDelivery" visibleInAdvancedArea="true" hasValueHelpDialog="true"  />
					<smartFilterBar:ControlConfiguration key="ShipToParty" visibleInAdvancedArea="true" hasValueHelpDialog="true" displayBehaviour="descriptionAndId" preventInitialDataFetchInValueHelpDialog="false" />
					<smartFilterBar:ControlConfiguration key="SoldToParty" visibleInAdvancedArea="true" hasValueHelpDialog="true" displayBehaviour="descriptionAndId" preventInitialDataFetchInValueHelpDialog="false" />
					<smartFilterBar:ControlConfiguration key="MaterialGroup" visibleInAdvancedArea="true" controlType="dropDownList" displayBehaviour="descriptionOnly" />
					<smartFilterBar:ControlConfiguration key="ShipmentStatus" visibleInAdvancedArea="true" controlType="dropDownList" displayBehaviour="descriptionOnly" />
					<smartFilterBar:ControlConfiguration key="InspectionStatus" visibleInAdvancedArea="true" controlType="dropDownList" displayBehaviour="descriptionOnly" />
					<smartFilterBar:ControlConfiguration key="StockType" visibleInAdvancedArea="true" controlType="dropDownList" displayBehaviour="descriptionOnly" />
					<smartFilterBar:ControlConfiguration key="SalesAdmin" visibleInAdvancedArea="true" hasValueHelpDialog="true" preventInitialDataFetchInValueHelpDialog="false" />
					<smartFilterBar:ControlConfiguration key="SalesRep" visibleInAdvancedArea="true" hasValueHelpDialog="true" preventInitialDataFetchInValueHelpDialog="false" />
					<smartFilterBar:ControlConfiguration key="Plant" visibleInAdvancedArea="true" hasValueHelpDialog="true" preventInitialDataFetchInValueHelpDialog="false"
						label="{i18n>main.owner}" />
				</smartFilterBar:controlConfiguration>
				
			<!-- layout data used to make the table growing but the filter bar fixed -->
				<smartFilterBar:layoutData>
					<FlexItemData shrinkFactor="0"/>
				</smartFilterBar:layoutData>
			</smartFilterBar:SmartFilterBar>
			
			<smartTable:SmartTable 
				id="SmartTable"
				entitySet="DeliveryHeadSet" 
				requestAtLeastFields="SoldToParty,DeliveryType,ShipToPartyText,SoldToPartyText,ShipToPartyPostalCode,ShipToPartyCity,ShipToPartyStreet,ShipToPartyCountry,SoldToPartyPostalCode,SoldToPartyCity,SoldToPartyStreet,SoldToPartyCountry,ShipmentStatus,InspectionStatus"
				ignoreFromPersonalisation="ArrivalDate,WeightUnit,VolumeUnit,Protocol,Comment,ExistingComment,Material,MaterialGroup,Progress,Plant,VetropackAccount,InspectionStatus"
				smartFilterId="smartFilterBar" 
				tableType="ResponsiveTable" 
				useExportToExcel="true" 
				useVariantManagement="true"
				useTablePersonalisation="true" 
				header="{i18n>main.shipments}" 
				showRowCount="true" 
				persistencyKey="DELIVERY_LIST_TABLE"
				enableAutoBinding="true" 
				placeToolbarInTable="true"
				class="sapUiResponsiveContentPadding">
				
				<smartTable:customToolbar>
					<Toolbar>
						<ToolbarSeparator />
						<Button  text="{i18n>main.createDelivery}" class="hppmTableHeaderButton" press="onNavToCreateDeliveryPress" />
						<Input placeholder="{i18n>main.scanLabel}" submit="onLabelScanSubmit" width="20rem"/>
						<ToolbarSpacer />
					
						<ToolbarSeparator />
						<Button icon="sap-icon://notes" tooltip="{i18n>main.printProtocol}" press="onPrintProtocolPress" />
						<Button icon="sap-icon://cancel" tooltip="{i18n>main.cancelDelivery}" press="onCancelDeliveryPress" />
						<ToolbarSeparator />
					</Toolbar>
				</smartTable:customToolbar>
				
				<Table mode="SingleSelectLeft" sticky="ColumnHeaders,HeaderToolbar" itemPress="onItemPress">

					<columns>
						
						<Column id="DeliveryKey" width="10%" demandPopin="false">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "DeliveryKey", 
												"columnIndex":"1", 
												"leadingProperty": "DeliveryKey", 
												"type": "string" }'/>
							</customData>
							<Text text="{i18n>main.shipment}"/>
						</Column>
						
						<Column id="ShipmentStatusText" width="12%" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "ShipmentStatusText", 
												"columnIndex":"2", 
												"leadingProperty": "ShipmentStatusText", 
												"type": "string" }'/>
							</customData>
							<Text text="{/#DeliveryHead/ShipmentStatus/@sap:label}"/>
						</Column>
				
					
						<Column id="InspectionStatusText" width="12%" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "InspectionStatusText", 
												"columnIndex":"3", 
												"leadingProperty": "InspectionStatusText", 
												"type": "string" }'/>
							</customData>
							<Text text="{/#DeliveryHead/InspectionStatus/@sap:label}"/>
						</Column>
						
						<Column id="CreatedBy" width="10%" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "CreatedBy", 
												"columnIndex":"4", 
												"leadingProperty": "CreatedBy", 
												"type": "string" }'/>
							</customData>
							<Text text="{/#DeliveryHead/CreatedBy/@sap:label}"/>
						</Column>
			
					
						<Column id="ShipToParty" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "ShipToParty", 
												"columnIndex":"5", 
												"leadingProperty": "ShipToParty", 
												"type": "string" }'/>
							</customData>
							<Text text="{/#DeliveryHead/ShipToParty/@sap:label}"/>
						</Column>
						
						<Column id="SoldToParty" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "SoldToParty", 
												"columnIndex":"6", 
												"leadingProperty": "SoldToParty", 
												"type": "string" }'/>
							</customData>
							<Text text="{/#DeliveryHead/SoldToParty/@sap:label}"/>
						</Column>
						
						<Column id="Claim" width="7%" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "Claim", 
												"columnIndex":"7", 
												"leadingProperty": "Claim", 
												"type": "boolean" }'/>
							</customData>
							<Text text="{/#DeliveryHead/Claim/@sap:label}"/>
						</Column>
						
						<Column id="DeliveryDate" width="7%" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "DeliveryDate", 
												"columnIndex":"8", 
												"leadingProperty": "DeliveryDate", 
												"type": "date" }'/>
							</customData>
							<Text text="{/#DeliveryHead/DeliveryDate/@sap:label}"/>
						</Column>

					</columns>
					
					<items>
						<ColumnListItem type="Navigation">
							<cells>
								<Text text="{DeliveryKey}"/>
								<ObjectStatus text="{ShipmentStatusText}" state= "{ path: 'ShipmentStatus', formatter: '.formatter.shipmentStatusState' }"/>
								<ObjectStatus text="{InspectionStatusText}"	state= "{ path: 'InspectionStatus', formatter: '.formatter.inspectionStatusState' }" />
								<Text text="{CreatedBy}"/>
								<VBox>
									<Text text="{ShipToPartyText} ({ShipToParty})"/>
									<Text text="{ShipToPartyCountry}-{ShipToPartyPostalCode}"/>
									<Text text="{ShipToPartyCity}"/>
								</VBox>
								<VBox>
									<Text text="{SoldToPartyText} ({SoldToParty})"/>
									<Text text="{SoldToPartyCountry}-{SoldToPartyPostalCode}"/>
									<Text text="{SoldToPartyCity}"/>
								</VBox>
					
								<ObjectStatus
									text="{= ${Claim} ? ${i18n>general.yes} : ${i18n>general.no} }"
									state="{= ${Claim} ? 'Error' : 'Success' }"
									icon="{= ${Claim} ? 'sap-icon://error' : 'sap-icon://sys-enter' }" />
									
								<Text text="{ path: 'DeliveryDate', type: 'sap.ui.model.odata.type.Date', formatOptions: { style: 'short' } }"/>
							</cells>
							</ColumnListItem>
					</items>
				</Table>
			</smartTable:SmartTable>
		</content>
		<footer>
			<OverflowToolbar>
				<Button
					icon="{ path: 'message>/', formatter: '.formatter.messageButtonIconFormatter' }"
					type="{ path: 'message>/', formatter: '.formatter.messageButtonTypeFormatter' }"
					text="{= ${message>/}.length}"
					press="onMessagePopoverPress"/>
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>