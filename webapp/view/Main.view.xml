<mvc:View controllerName="zvgt.hppm.delivery_list.controller.Main" 
	xmlns:mvc="sap.ui.core.mvc"  
	xmlns:core="sap.ui.core"
	xmlns="sap.m" 
	xmlns:smartFilterBar="sap.ui.comp.smartfilterbar" 
	xmlns:smartTable="sap.ui.comp.smarttable" 
	xmlns:tnt="sap.tnt"
	displayBlock="true">
	<Page title="{i18n>title}">
		<content>
			
			<smartFilterBar:SmartFilterBar 
				id="smartFilterBar" 
				entitySet="DeliveryHeadSet" 
				persistencyKey="SmartFilter_Explored"
				showFilterConfiguration="true">
				
				<smartFilterBar:controlConfiguration>
					<smartFilterBar:ControlConfiguration key="DeliveryKey" visibleInAdvancedArea="true" hasValueHelpDialog="false" />
					<smartFilterBar:ControlConfiguration key="Plant" visibleInAdvancedArea="true" hasValueHelpDialog="true" displayBehaviour="descriptionAndId"
						preventInitialDataFetchInValueHelpDialog="false"/>
						<smartFilterBar:ControlConfiguration key="DeliveryDate" visibleInAdvancedArea="true" index="2" 
						conditionType="sap.ui.comp.config.condition.DateRangeType"/>
					<smartFilterBar:ControlConfiguration key="TruckNumber" visibleInAdvancedArea="true" hasValueHelpDialog="false"  />
					<smartFilterBar:ControlConfiguration key="CustomerDelivery" visibleInAdvancedArea="true" hasValueHelpDialog="false"  />
					<smartFilterBar:ControlConfiguration key="ShipToParty" visibleInAdvancedArea="true" hasValueHelpDialog="true" displayBehaviour="descriptionAndId" preventInitialDataFetchInValueHelpDialog="false" />
					<smartFilterBar:ControlConfiguration key="SoldToParty" visibleInAdvancedArea="true" hasValueHelpDialog="true" displayBehaviour="descriptionAndId" preventInitialDataFetchInValueHelpDialog="false" />
					<smartFilterBar:ControlConfiguration key="MaterialGroup" visibleInAdvancedArea="true" hasValueHelpDialog="true" preventInitialDataFetchInValueHelpDialog="false"
						controlType="dropDownList" displayBehaviour="descriptionOnly" />
				</smartFilterBar:controlConfiguration>
				
			<!-- layout data used to make the table growing but the filter bar fixed -->
				<smartFilterBar:layoutData>
					<FlexItemData shrinkFactor="0"/>
				</smartFilterBar:layoutData>
			</smartFilterBar:SmartFilterBar>
			
			<smartTable:SmartTable 
				id="SmartTable"
				entitySet="DeliveryHeadSet" 
				requestAtLeastFields="ShipToPartyText,SoldToPartyText"
				smartFilterId="smartFilterBar" 
				tableType="ResponsiveTable" 
				useExportToExcel="true" 
				useVariantManagement="true"
				useTablePersonalisation="true" 
				header="{i18n>main.shipments}" 
				showRowCount="true" 
				persistencyKey="SmartTableAnalytical_Explored"
				enableAutoBinding="true" 
				placeToolbarInTable="true"
				class="sapUiResponsiveContentPadding">
				
				<smartTable:customToolbar>
					<Toolbar>
							<ToolbarSeparator />
							<Button  text="{i18n>main.createDelivery}" class="hppmTableHeaderButton" />
						<ToolbarSpacer />
					
						<ToolbarSeparator />
						<Button icon="sap-icon://print" tooltip="{i18n>main.printDelivery}" press="onPrintDeliveryPress" />
						<Button icon="sap-icon://notes" tooltip="{i18n>main.printProtocol}" />
						<Button icon="sap-icon://cancel" tooltip="{i18n>main.cancelDelivery}" />
							<ToolbarSeparator />
					</Toolbar>
				</smartTable:customToolbar>
				
				<Table mode="SingleSelectLeft" sticky="ColumnHeaders,HeaderToolbar" itemPress="onItemPress">

					<columns>
						
						<Column id="DeliveryKey" width="10%" demandPopin="false">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "DeliveryKey", 
												"maxLength": "20",
												"columnIndex":"1", 
												"leadingProperty": "DeliveryKey", 
												"type": "string" }'/>
							</customData>
							<Text text="{/#DeliveryHead/DeliveryKey/@sap:label}"/>
						</Column>
						
						<Column id="ShipmentStatus" width="10%" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "ShipmentStatus", 
												"maxLength": "20",
												"columnIndex":"2", 
												"leadingProperty": "ShipmentStatus", 
												"type": "string" }'/>
							</customData>
							<Text text="{/#DeliveryHead/ShipmentStatus/@sap:label}"/>
						</Column>
				
					
						<Column id="LoadingStatus" width="15%" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "LoadingStatus", 
												"maxLength": "20",
												"columnIndex":"3", 
												"leadingProperty": "LoadingStatus", 
												"type": "string" }'/>
							</customData>
							<Text text="{/#DeliveryHead/LoadingStatus/@sap:label}"/>
						</Column>
						
						<Column id="CreatedBy" width="10%" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "CreatedBy", 
												"maxLength": "20",
												"columnIndex":"4", 
												"leadingProperty": "CreatedBy", 
												"type": "string" }'/>
							</customData>
							<Text text="{/#DeliveryHead/CreatedBy/@sap:label}"/>
						</Column>
			
					
						<Column id="ShipToParty" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "ShipToParty", 
												"maxLength": "100",
												"columnIndex":"5", 
												"leadingProperty": "ShipToParty", 
												"type": "string" }'/>
							</customData>
							<Text text="{/#DeliveryHead/ShipToParty/@sap:label}"/>
						</Column>
						
						<Column id="SoldToParty" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "SoldToParty", 
												"maxLength": "100",
												"columnIndex":"6", 
												"leadingProperty": "SoldToParty", 
												"type": "string" }'/>
							</customData>
							<Text text="{/#DeliveryHead/SoldToParty/@sap:label}"/>
						</Column>
						
						<Column id="Claim" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
							<customData>
								<core:CustomData key="p13nData"
									value='\{	"columnKey": "Claim", 
												"maxLength": "100",
												"columnIndex":"7", 
												"leadingProperty": "Claim", 
												"type": "boolean" }'/>
							</customData>
							<Text text="{/#DeliveryHead/Claim/@sap:label}"/>
						</Column>
					</columns>
					
					<items>
						<ColumnListItem type="Navigation">
							<cells>
								<Text text="{DeliveryKey}"/>
								<tnt:InfoLabel text="{ShipmentStatus}" displayOnly="true" colorScheme= "{ path: 'ShipmentStatus', formatter: '.formatter.shipmentStatusColorScheme' }" />
								<tnt:InfoLabel text="{LoadingStatus}" displayOnly="true" colorScheme= "{ path: 'LoadingStatus', formatter: '.formatter.loadingStatusColorScheme' }" />
								<Text text="{CreatedBy}"/>
								<Text text="{ShipToPartyText} ({ShipToParty})"/>
								<Text text="{SoldToPartyText} ({SoldToParty})"/>
								<Text text="{= ${Claim} ? ${i18n>general.yes} : ${i18n>general.no} }" />
							</cells>
							</ColumnListItem>
					</items>
				</Table>
			</smartTable:SmartTable>
		</content>
	</Page>
</mvc:View>