<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	controllerName="zvgt.hppm.delivery_list.controller.Registration" xmlns:uxap="sap.uxap" xmlns:f="sap.ui.layout.form"
	xmlns:hppm="zvgt.hppm.controls">
	<uxap:ObjectPageLayout upperCaseAnchorBar="false" showFooter="true">
		<uxap:headerTitle>
			<uxap:ObjectPageHeader objectTitle="{i18n>registration.title}"/>
		</uxap:headerTitle>
		<uxap:sections>
			<uxap:ObjectPageSection titleUppercase="false" title="{i18n>registration.pod}">
				<uxap:subSections>
					<uxap:ObjectPageSubSection titleUppercase="false">
						<uxap:blocks>
							<VBox>
								<f:Form editable="true" id="RegistrationForm" fieldGroupIds="Registration">
									<f:layout>
										<f:ResponsiveGridLayout labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0"
											emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="2" singleContainerFullSize="false"/>
									</f:layout>
									<f:formContainers>
										<f:FormContainer >
											<f:formElements>
												<f:FormElement label="{i18n>registration.shipmentArrival}">
													<f:fields>
														<DatePicker value="{ path: 'ArrivalDate', type: 'sap.ui.model.odata.type.DateTime', constraints: { displayFormat: 'Date' }, formatOptions: { style: 'short' } }"/>
														<TimePicker value="{ path: 'ArrivalTime', type: 'sap.ui.model.odata.type.Time' }"/>
													</f:fields>
												</f:FormElement>
												<f:FormElement label="{i18n>registration.confirmedBy}">
													<f:fields>
														<Input value="{ConfirmedBy}"/>
													</f:fields>
												</f:FormElement>
											</f:formElements>
										</f:FormContainer>
										<f:FormContainer >
											<f:formElements>
												<f:FormElement label="{i18n>registration.truckNumber}">
													<f:fields>
														<Input value="{TruckNumber}" required="true"/>
													</f:fields>
												</f:FormElement>
												<f:FormElement label="{i18n>registration.customerDeliver}">
													<f:fields>
														<Input value="{CustomerDelivery}"/>
													</f:fields>
												</f:FormElement>
											</f:formElements>
										</f:FormContainer>
									</f:formContainers>
								</f:Form>
								<f:Form editable="true">
									<f:layout>
										<f:ResponsiveGridLayout labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0"
											emptySpanL="2" emptySpanM="0" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false"/>
									</f:layout>
									<f:formContainers>
										<f:FormContainer >
											<f:formElements>
												<f:FormElement label="{i18n>registration.comments}">
													<f:fields>
														<TextArea value="{Comment}"/>
													</f:fields>
												</f:FormElement>
											</f:formElements>
										</f:FormContainer>
									</f:formContainers>
								</f:Form>
							</VBox>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection titleUppercase="false" title="{i18n>registration.materials}" showTitle="true">
				<uxap:subSections>
					<uxap:ObjectPageSubSection titleUppercase="false">
						<uxap:blocks>
							<List id="MaterialList" headerText="{i18n>registration.customer}: {SoldToPartyText}"></List>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
			
					<uxap:ObjectPageSection titleUppercase="false" title="{i18n>general.documents}" showTitle="true">
				<uxap:subSections>
					<uxap:ObjectPageSubSection titleUppercase="false">
						<uxap:blocks>
							<hppm:UploadCollection
								id="uploadCollection"
								uploadUrl="/sap/opu/odata/sap/ZVGT_UI_HPPM_DELIVERY_LIST_SRV/FileSet"
								change="onFileUploaderChange"
								uploadComplete="onFileUploadComplete"
								fileDeleted="onFileDelete"
								fileType="jpg,png,pdf">
							</hppm:UploadCollection>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>
		<uxap:footer>
			<OverflowToolbar>
				<Button icon="{ path: 'message>/', formatter: '.formatter.messageButtonIconFormatter' }"
					type="{ path: 'message>/', formatter: '.formatter.messageButtonTypeFormatter' }" text="{= ${message>/}.length}"
					press="onMessagePopoverPress"/>
				<ToolbarSpacer/>
				<Button text="{i18n>general.next}" type="Emphasized" press="onSavePress"/>
				<Button text="{i18n>general.cancel}" type="Reject" press="onCancelPress"/>
			</OverflowToolbar>
		</uxap:footer>
	</uxap:ObjectPageLayout>
</mvc:View>