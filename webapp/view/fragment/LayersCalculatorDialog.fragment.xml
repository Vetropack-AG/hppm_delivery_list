<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog title="{i18n>layersCalculatorDialog.title}" contentWidth="{= ${device>/system/desktop} ? '30%' : '95%' }">
		<Table items="{/PalletCalculatorSet}" mode="Delete" delete="onLayerItemDelete">
			<headerToolbar>
				<Toolbar>
					<Input value="{ViewSettings>/LayerHeight}" />
					<ToolbarSpacer/>
					<Button icon="sap-icon://add" press="onAddLayerPress"/>
				</Toolbar>
			</headerToolbar>
			<columns>
				<Column >
					<Select selectedKey="{ViewSettings>/LayersCalculatorMode}" width="100%" change="onLayersCalculatorModeChange">
						<core:Item key="HEIGHT" text="{i18n>layersCalculatorDialog.height}"/>
						<core:Item key="PIECES" text="{i18n>layersCalculatorDialog.pieces}"/>
					</Select>
				</Column>
				<Column width="1rem"/>
				<Column >
					<Text text="{i18n>layersCalculatorDialog.pallets}"/>
				</Column>
				<Column width="1rem"/>
				<Column >
					<Text text="{i18n>layersCalculatorDialog.result}"/>
					<footer>
						<Text text="{ViewSettings>/LayerResult}"/>
					</footer>
				</Column>
			</columns>
			<items>
				<ColumnListItem>
					<VBox>
						<StepInput value="{ path:'Height', type:'sap.ui.model.odata.type.Int16' }" visible="{= ${ViewSettings>/LayersCalculatorMode} === 'HEIGHT' }"/>
						<StepInput value="{ path:'Pieces', type:'sap.ui.model.odata.type.Int16' }" visible="{= ${ViewSettings>/LayersCalculatorMode} === 'PIECES' }"/>
					</VBox>
					<Text text="x"/>
					<StepInput value="{ path:'PalletCount', type:'sap.ui.model.odata.type.Int16' }" max="100" valueStateText="{i18n>layersCalculatorDialog.maxpallets}"/>
					<Text text="="/>
					<Text
						text="{ parts: [ 'Pieces', 'PalletCount', 'Height', 'ViewSettings>/LayersCalculatorMode' ], formatter: '.formatter.calculateLayerLineResult', events: { change: '.onLayerResultChange' } }"/>
				</ColumnListItem>
			</items>
		</Table>
		<beginButton>
			<Button text="{i18n>general.ok}" type="Emphasized" press="onLayersCalculatorOkPress"/>
		</beginButton>
	</Dialog>
</core:FragmentDefinition>