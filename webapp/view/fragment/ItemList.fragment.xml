<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<List id="ItemList" itemPress="onDetailItemPress" mode="SingleSelectLeft">
		<headerToolbar>
			<OverflowToolbar>
				<SearchField placeholder="{i18n>details.scanPalletOrMaterial}" width="70%" suggestionItems="{ViewSettings>/LastScannedPallets}" search="onPalletSearch" 
				enableSuggestions="true" suggest="onPalletSuggest" visible="{= ${DeliveryType} !== 'ZRET' }">
					<suggestionItems>
						<SuggestionItem key="{ViewSettings>Scan}" text="{ViewSettings>Scan}"/>
					</suggestionItems>
				</SearchField>
				<ToolbarSpacer/>
				<Button icon="sap-icon://BusinessSuiteInAppSymbols/icon-truck-load" tooltip="{i18n>main.load}" press="onLoadPress" visible="{= ${DeliveryType} !== 'ZRET' }"/>
				<Button icon="sap-icon://BusinessSuiteInAppSymbols/icon-truck-unload" tooltip="{i18n>main.unload}" press="onUnloadPress" visible="{= ${DeliveryType} !== 'ZRET' }"/>
				<ToolbarSeparator />
				<Button icon="sap-icon://add" press="onAddItemPress" visible="{= ${UI>/IsInternalUser} === true }"/>
				<Button icon="sap-icon://delete" press="onDeleteItemPress" visible="{= ${UI>/IsInternalUser} === true }"/>
			</OverflowToolbar>
		</headerToolbar>
	</List>
</core:FragmentDefinition>