<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog draggable="true" title="{i18n>postItemsDialog.title}" contentWidth="65%">
		<f:Form editable="true">
			<f:layout>
				<f:ResponsiveGridLayout labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="5" singleContainerFullSize="true"/>
			</f:layout>
			<f:formContainers>
				<f:FormContainer>
					<f:formElements>
						<f:FormElement label="{i18n>details.loadAt}">
							<f:fields>
								<Text text="{SoldToPartyText} ({SoldToParty})"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>details.unloadAt}">
							<f:fields>
								<Text text="{ShipToPartyText} ({ShipToParty})"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>postItemDialog.owner}">
							<f:fields>
								<Text text="{PlantText} ({Plant})"/>
							</f:fields>
						</f:FormElement>

						<f:FormElement label="{i18n>postItemDialog.soldTo}">
							<f:fields>
								<Select items="{ path: '/SoldToValueHelpSet' }">
										<core:ListItem key="{Key}" text="{Text} ({Key})" />
								</Select>
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>
			</f:formContainers>
		</f:Form>
		<Table>
			<columns>
				<Column width="7%">
					<Text text="{i18n>details.sapNo}"/>
				</Column>
				<Column width="auto" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
					<Text text="{i18n>details.sapName}"/>
				</Column>
				<Column width="15%" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
					<Text text="{i18n>postItemDialog.stockType}"/>
				</Column>
				<Column width="15%" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
					<Text text="{i18n>postItemDialog.postingQuantity}"/>
				</Column>
				<Column width="15%" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
					<Text text="{i18n>postItemDialog.maxReturnDelivery}"/>
				</Column>
				<Column width="15%" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
					<Text text="{i18n>postItemDialog.postingDate}"/>
				</Column>
			</columns>
		</Table>
		<buttons>
			<Button text="{i18n>details.sapPosting}" type="Emphasized" press="onPostItemsDialogSavePress"/>
			<Button text="{i18n>general.cancel}" press="onPostItemsCancelSavePress"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>