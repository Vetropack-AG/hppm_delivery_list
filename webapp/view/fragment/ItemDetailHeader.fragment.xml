<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout">
	
	<layout:VerticalLayout>
		<ObjectStatus title="{i18n>details.loadAt}" text="{Header>/SoldToPartyText}"/>
		<ObjectStatus title="{i18n>details.unloadAt}" text="{Header>/ShipToPartyText}"/>
	</layout:VerticalLayout>
	<layout:VerticalLayout>
		<ObjectStatus title="{i18n>details.truckNumber}" text="{Header>/TruckNumber}"/>
		<ObjectStatus title="{i18n>details.deliveryDate}"
			text="{ path: 'Header>/DeliveryDate', type: 'sap.ui.model.odata.type.Date', formatOptions: { style: 'short' } }"/>
	</layout:VerticalLayout>
	
	
	<layout:VerticalLayout>
		<ObjectStatus 
			title="{i18n>details.status}" 
			text="{InspectionStatusText}"
			state="{ path: 'InspectionStatus', formatter: '.formatter.itemInspectionStatusState' }"
			icon="{ path: 'InspectionStatus', formatter: '.formatter.itemInspectionStatusIcon' }"/>
		<ObjectStatus title="{i18n>details.by}"
			text="{ChangedBy} {i18n>details.on} { path: 'ChangedOn', type: 'sap.ui.model.odata.type.Date', formatOptions: { style: 'short' } }"/>
	</layout:VerticalLayout>
	<layout:VerticalLayout>
		<ObjectStatus 
			title="{i18n>details.materialDocumentPrePosting}" 
			text="{MaterialDocumentPrePosting}" 
			visible="{= ${MaterialDocumentPrePosting} !== '' }"
			state="Success" 
			icon="sap-icon://accept"/>
	<ObjectStatus 
		title="{i18n>details.materialDocumentFinalPosting}" 
		text="{MaterialDocumentFinalPosting}" 
		visible="{= ${MaterialDocumentFinalPosting} !== '' }"
		state="Success"
		icon="sap-icon://accept"/>
	</layout:VerticalLayout>
	
	<layout:VerticalLayout>
		<ObjectStatus 
			text="{i18n>details.quantityResult}" 
			state="{= ${QuantityResult} === true ? 'Success' : 'Error' }" 
			icon="{= ${QuantityResult} === true ? 'sap-icon://sys-enter-2' : 'sap-icon://message-error' }"/>
	<ObjectStatus 
			text="{i18n>details.qualityResult}" 
			state="{= ${QualityResult} === true ? 'Success' : 'Error' }" 
			icon="{= ${QualityResult} === true ? 'sap-icon://sys-enter-2' : 'sap-icon://message-error' }"/>
	</layout:VerticalLayout>
	
</core:FragmentDefinition>