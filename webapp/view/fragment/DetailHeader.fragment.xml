<core:FragmentDefinition xmlns:m="sap.m" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout">
	<layout:VerticalLayout>
		<m:ObjectStatus title="{i18n>details.loadAt}" text="{SoldToPartyText} ({SoldToParty})"/>
		<m:ObjectStatus title="{i18n>details.unloadAt}" text="{ShipToPartyText} ({ShipToParty})"/>
	</layout:VerticalLayout>
	<layout:VerticalLayout>
		<m:ObjectStatus title="{i18n>details.truckNumber}" text="{TruckNumber}"/>
		<m:ObjectStatus title="{i18n>details.deliveryDate}"
			text="{ path: 'DeliveryDate', type: 'sap.ui.model.odata.type.Date', formatOptions: { style: 'short' } }"/>
	</layout:VerticalLayout>
	<layout:VerticalLayout>
		<m:ObjectStatus title="{i18n>details.status}" text="{InspectionStatusText}"
			state="{ path: 'InspectionStatus', formatter: '.formatter.itemInspectionStatusState' }"/>
		<m:ObjectStatus title="{i18n>details.by}"
			text="{ChangedBy} {i18n>details.on} { path: 'ChangedOn', type: 'sap.ui.model.odata.type.Date', formatOptions: { style: 'short' } }"/>
	</layout:VerticalLayout>
	<layout:VerticalLayout>
		<m:ObjectStatus title="{i18n>details.progress}"/>
		<m:ProgressIndicator percentValue="{ path: 'Progress', type: 'sap.ui.model.odata.type.String' }" displayValue="{ path: 'Progress' } %"
			state="{ path: 'Progress', formatter: '.formatter.progressState' }"/>
	</layout:VerticalLayout>
</core:FragmentDefinition>