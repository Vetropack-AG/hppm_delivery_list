<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form">
	<Dialog draggable="true" title="{i18n>postItemDialog.title}" contentWidth="20%">
		<f:Form editable="false">
			<f:layout>
				<f:ResponsiveGridLayout labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="5" singleContainerFullSize="true"/>
			</f:layout>
			<f:formContainers>
				<f:FormContainer>
					<f:formElements>
						<f:FormElement label="{i18n>details.loadAt}">
							<f:fields>
								<Text text="{Header>/SoldToPartyText} ({Header>/SoldToParty})"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>details.unloadAt}">
							<f:fields>
								<Text text="{Header>/ShipToPartyText} ({Header>/ShipToParty})"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>postItemDialog.owner}">
							<f:fields>
								<Text text="{Header>/Plant} ({Header>/PlantText})"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>details.sapNo}">
							<f:fields>
								<Text text="{MaterialNumber}"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>details.sapName}">
							<f:fields>
								<Text text="{ItemText}"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>postItemDialog.stockType}">
							<f:fields>
								<Text text="{= ${SpecialStock} === 'O' ? ${i18n>postItemDialog.soldStock} : ${i18n>postItemDialog.rentStock} }"/>
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>
			</f:formContainers>
		</f:Form>
		<f:Form editable="true">
			<f:layout>
				<f:ResponsiveGridLayout labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="5" singleContainerFullSize="true"/>
			</f:layout>
			<f:formContainers>
				<f:FormContainer>
					<f:formElements>
						<f:FormElement label="{i18n>postItemDialog.postingQuantity}">
							<f:fields>
								<StepInput value="{ path:'QtyPosted', type:'sap.ui.model.odata.type.Decimal' }" min="1"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>postItemDialog.maxReturnDelivery}" visible="{= ${SpecialStock} === 'O' }">
							<f:fields>
								<StepInput value="{ path:'ViewSettings>/MaxReturn', type:'sap.ui.model.odata.type.Decimal' }" min="1"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>postItemDialog.postingDate}" visible="{= ${SpecialStock} !== 'O' }">
							<f:fields>
							    <DatePicker value="{ path: 'ViewSettings>/PostingDate', type: 'sap.ui.model.odata.type.DateTime', constraints: { displayFormat: 'Date' } }"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>postItemDialog.manualPosting}">
							<f:fields>
								<Switch state="{ViewSettings>/ManualPosting}" type="AcceptReject"/>
								<Input placeholder="{i18n>postItemDialog.materialDocument}" value="{ViewSettings>/MaterialDocument}" visible="{ViewSettings>/ManualPosting}">
									<layoutData>
										<l:GridData span="XL1 L2 M2 S4"/>
									</layoutData>
								</Input>
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>
			</f:formContainers>
		</f:Form>
		<buttons>
			<Button text="{i18n>details.sapPosting}" type="Emphasized" press="onPostItemDialogSavePress"/>
			<Button text="{i18n>general.cancel}" press="onPostItemCancelSavePress"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>