<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form" xmlns:l="sap.ui.layout">
	<VBox>
		<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12"
			adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="4" emptySpanS="0" columnsXL="3" columnsL="3" columnsM="3"
			singleContainerFullSize="false">
			<f:content>
			
				<Label text="{i18n>details.material}"/>
				<ComboBox items="{ path: '/LoadCarrierTypeValueHelpSet', templateShareable: false}" selectedKey="{MaterialNumber}"
					showSecondaryValues="true" filterSecondaryValues="true" required="true" id="material" selectionChange="onMaterialChange">
					<core:ListItem key="{Key}" text="{Key} - {Description}" additionalText="{MaterialGroup}"/>
				</ComboBox>
				<Toolbar visible="false"/>
				
				<!-- Not editable for detail data, Only for new item -->
				<Label text="{i18n>details.deliveryQuantity}"/>
				<StepInput value="{ path:'Quantity', type:'sap.ui.model.odata.type.Decimal' }" min="1"
					change="calculateClaimQuantity" editable="{= ${InspectionStatus} === '' || ${InspectionStatus} === undefined }">
				</StepInput>
				
				<Toolbar visible="false"/>
				<!-- Not Editable -->
				<Label text="{i18n>details.washedQuantity}" visible="{= ${MaterialGroup} === 'LEI-LAYER' }"/>
				<StepInput value="{ path:'WashedQuantity', type:'sap.ui.model.odata.type.Decimal' }" editable="false" visible="{= ${MaterialGroup} === 'LEI-LAYER' }" />
			
			</f:content>
		</f:SimpleForm>
		<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12"
			adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="4" emptySpanS="0" columnsXL="3" columnsL="3" columnsM="3"
			singleContainerFullSize="false">
			<f:content>
				<!-- Editable as long as status not POSTED -->
				<Label text="{i18n>details.actualQuantity}"/>
				<HBox>
					<StepInput value="{ path:'ActualQuantity', type:'sap.ui.model.odata.type.Decimal' }" 
						id="ActualQuantityInput"
						min="0"
						editable="false" 
						change="onDeliveryQuantityChange"
						enabled="{= ${InspectionStatus} !== 'POSTED' }"
						/>
					<Button icon="sap-icon://simulate" width="1rem" class="sapUiTinyMarginBegin" press="onOpenPalletsCalculatorPress" enabled="{= ${InspectionStatus} !== 'POSTED' }"
						 />
				</HBox>
				
				<!-- Editable -->
				<Label text="{i18n>details.needRepairQuantity}" visible="{= ${MaterialGroup} === 'LEI-PALLE' }"/>
				<VBox visible="{= ${MaterialGroup} === 'LEI-PALLE' }">
					<StepInput value="{ path:'NeedRepairQuantity', type:'sap.ui.model.odata.type.Decimal' }" change=".quantityCalculator.calculateAllFields" min="0" 
						visible="{= ${MaterialGroup} === 'LEI-PALLE' }" editable="{= ${NoRepair} !== true }" />
					<CheckBox selected="{NoRepair}" text="{i18n>details.noRepair}" wrapping="true" select="onNoRepairChange"
						visible="{= ${MaterialGroup} === 'LEI-PALLE' }" />
				</VBox>
				
				<!-- Editable -->
				<Label text="{i18n>details.needScrapQuantity}" />
				<VBox>
					<StepInput value="{ path:'NeedScrapQuantity', type:'sap.ui.model.odata.type.Decimal' }" change=".quantityCalculator.calculateAllFields" min="0"
						editable="{= ${NoScrap} !== true }"/>
					<CheckBox selected="{NoScrap}" text="{i18n>details.noScrap}" wrapping="true" select="onNoScrapChange"/>
				</VBox>
				
				<!-- 5.4.2021 New logic: Editable but Calculated: ActualQuantity - TotalClaimQuantity (=RepairQuantityAboveTolerance + ScrapQuantityAboveTolerance) -->
                <!-- Logic above not relevant anymore from mail Janis on 20.10.2022 -->
                <!-- New logic: WashedQuantity + NeedScrapQuantity - ScrapQuantityWithinTolerance -->
				<Label text="{i18n>details.bookedQuantity}" />
				<StepInput value="{ path:'QtyPosted', type:'sap.ui.model.odata.type.Decimal' }" editable="{= ${InspectionStatus} !== 'POSTED' }" 
					min="0"/>
				
				<Toolbar visible="false"/>
				
				<!-- Calculated: Quantity - ActualQuantity -->
				<Label text="{i18n>details.claimQuantity}"/>
				<StepInput value="{ path:'ClaimQuantity', type:'sap.ui.model.odata.type.Decimal' }" editable="false" />
				
				<!-- Calculated: ActualQuantity - NeedRepairQuantity - NeedScrapQuantity -->
				<Label text="{i18n>details.freeOfDefects}"/>
				<StepInput value="{ path:'OkQuantity', type:'sap.ui.model.odata.type.Decimal' }" editable="false"/>
				
				<!-- Calculated: ActualQuantity x RepairTolerance -->
				<Label text="{i18n>details.repairQuantityWithinTolerance}"/>
				<StepInput value="{ path:'RepairQuantity', type:'sap.ui.model.odata.type.Decimal' }" editable="false"
					visible="{= ${MaterialGroup} === 'LEI-PALLE' }"/>
			
				<!-- Calculated: NeedRepairQuantity - RepairQuantity -->
				<Label text="{i18n>details.claimRepairAboveTolerance}" visible="{= ${MaterialGroup} === 'LEI-PALLE' }"/>
				<StepInput value="{ path:'RepairQuantityAboveTolerance', type:'sap.ui.model.odata.type.Decimal' }" editable="false"
					visible="{= ${MaterialGroup} === 'LEI-PALLE' }" />
				
				<Toolbar visible="false"/>
				
				<!-- Calculated: RepairQuantityAboveTolerance + ScrapQuantityAboveTolerance -->
				<Label text="{i18n>details.totalClaimQuantity}"/>
				<StepInput value="{ path:'TotalClaimQuantity', type:'sap.ui.model.odata.type.Decimal' }" editable="false"/>
				
				<!-- Calculated: ActualQuantity x ScrapTolerance -->
				<Label text="{i18n>details.claimScrapWithinTolerance}"/>
				<StepInput value="{ path:'ScrapQuantity', type:'sap.ui.model.odata.type.Decimal' }" editable="false"/>
				
				<!-- Calculated: NeedScrapQuantity - ScrapQuantity -->
				<Label text="{i18n>details.scrapAboveTolerance}"/>
				<StepInput value="{ path:'ScrapQuantityAboveTolerance', type:'sap.ui.model.odata.type.Decimal' }" editable="false"/>
				
				<!-- Calculated: ActualQuantity - ( WashedQuantity + NeedRepairQuantity + NeedScrapQuantity ) -->
				<Label text="{i18n>details.checkQuantity}" visible="{= ${MaterialGroup} === 'LEI-LAYER' }"/>
				<StepInput value="{ path:'PcsToBeChecked', type:'sap.ui.model.odata.type.Decimal' }" editable="false" visible="{= ${MaterialGroup} === 'LEI-LAYER' }"/>
				
			</f:content>
		</f:SimpleForm>
	</VBox>
</core:FragmentDefinition>