<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns:uxap="sap.uxap" xmlns="sap.m"
	controllerName="zvgt.hppm.delivery_list.controller.ItemDetail">
	<uxap:ObjectPageLayout upperCaseAnchorBar="false" showFooter="true">
		<uxap:headerTitle>
			<uxap:ObjectPageHeader objectTitle="{i18n>details.delivery}: {DeliveryKey} / {ItemKey}" objectSubtitle="{ItemText}">
				<uxap:actions>
					<uxap:ObjectPageHeaderActionButton icon="sap-icon://print" text="{i18n>details.print}" tooltip="{i18n>details.print}" type="Transparent"
						press="onPrintItemPress"/>
				</uxap:actions>
			</uxap:ObjectPageHeader>
		</uxap:headerTitle>
		<uxap:headerContent>
			<core:Fragment fragmentName="zvgt.hppm.delivery_list.view.fragment.ItemDetailHeader" type="XML"/>
		</uxap:headerContent>
		<uxap:sections>
			<uxap:ObjectPageSection showTitle="false">
				<uxap:subSections>
					<uxap:ObjectPageSubSection titleUppercase="false">
						<uxap:blocks>
							<MessageStrip text="{i18n>message.noPallets}" type="Error" showIcon="true" showCloseButton="false" visible="{= ${HasPallets} === false }"/>
							<core:Fragment fragmentName="zvgt.hppm.delivery_list.view.fragment.ItemDetailData" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>
		<uxap:footer>
			<OverflowToolbar>
				<Button icon="{ path: 'message>/', formatter: '.formatter.messageButtonIconFormatter' }"
					type="{ path: 'message>/', formatter: '.formatter.messageButtonTypeFormatter' }" text="{= ${message>/}.length}"
					press="onMessagePopoverPress"/>
				<ToolbarSpacer/>
				<Button text="{i18n>details.sapPosting}" type="Emphasized" press="onSapPostingPress" enabled="{HasPallets}"/>
				<Button text="{i18n>details.prePosting}" type="Emphasized" press="onPrePostingPress" enabled="{HasPallets}" visible="{ViewSettings>/ItemPrinted}"/>
				<Button text="{i18n>general.confirm}" type="Accept" press="onSavePress" enabled="{HasPallets}"/>
				<Button text="{i18n>general.cancel}" type="Reject" press="onCancelPress"/>
			</OverflowToolbar>
		</uxap:footer>
	</uxap:ObjectPageLayout>
</mvc:View>