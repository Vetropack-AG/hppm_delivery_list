<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" controllerName="zvgt.hppm.delivery_list.controller.Detail" xmlns="sap.uxap"
	xmlns:m="sap.m" xmlns:hppm="zvgt.hppm.controls">
	<ObjectPageLayout upperCaseAnchorBar="false" showFooter="true">
		<headerTitle>
			<ObjectPageHeader objectTitle="{i18n>details.delivery}: {DeliveryKey}" objectSubtitle="{i18n>details.protocolNumber}: {DeliveryKey}">
				<actions>
					<ObjectPageHeaderActionButton icon="sap-icon://post" text="{i18n>details.comment}" tooltip="{i18n>details.comment}" press="onAddCommentPress"/>
					<ObjectPageHeaderActionButton icon="sap-icon://print" text="{i18n>details.print}" tooltip="{i18n>details.print}" press="onPrintItemPress"/>
				</actions>
			</ObjectPageHeader>
		</headerTitle>
		<headerContent>
			<core:Fragment fragmentName="zvgt.hppm.delivery_list.view.fragment.DetailHeader" type="XML"/>
		</headerContent>
		<sections>
			<ObjectPageSection titleUppercase="false" title="{i18n>details.items}">
				<subSections>
					<ObjectPageSubSection titleUppercase="false">
						<blocks>
							<core:Fragment fragmentName="zvgt.hppm.delivery_list.view.fragment.ItemList" type="XML"/>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
			<ObjectPageSection titleUppercase="false" title="{i18n>details.documents}">
				<subSections>
					<ObjectPageSubSection titleUppercase="false">
						<blocks>
							<hppm:UploadCollection
								id="uploadCollection"
								uploadUrl="/sap/opu/odata/sap/ZVGT_UI_HPPM_DELIVERY_LIST_SRV/FileSet"
								change="onFileUploaderChange"
								uploadComplete="onFileUploadComplete"
								fileDeleted="onFileDelete"
								fileType="jpg,png,pdf">
							</hppm:UploadCollection>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
		</sections>
		<footer>
			<m:OverflowToolbar>
				<m:Button icon="{ path: 'message>/', formatter: '.formatter.messageButtonIconFormatter' }"
					type="{ path: 'message>/', formatter: '.formatter.messageButtonTypeFormatter' }" text="{= ${message>/}.length}"
					press="onMessagePopoverPress"/>
				<m:ToolbarSpacer/>
				<m:Button text="{i18n>details.sapPosting}" type="Emphasized" press="onSapPostingPress" id="SapPostingButton"
					visible="{= ${DeliveryType} === 'ZRET' &amp;&amp; 
								${InspectionStatus} !== 'POSTED' &amp;&amp; 
								${InspectionStatus} !== 'COMPLETED' &amp;&amp; 
								${UI>/IsInternalUser} === true
							}"/>
				<m:Button text="{i18n>details.finishLoading}" press="onConfirmLoadingPress" 
					visible="{= ( 	${InspectionStatus} === 'OPEN' || 
									${InspectionStatus} === 'QUALITY' || 
									${InspectionStatus} === 'QUANTITY' ) &amp;&amp; 
									${Header>/DeliveryType} !== 'ZRET' &amp;&amp; 
									${UI>/IsInternalUser} === true
								}"/>
				<m:Button text="{i18n>details.finishUnloading}" press="onConfirmUnloadingPress" 
					visible="{= 	${InspectionStatus} === 'LOADED' &amp;&amp; 
									${Header>/DeliveryType} !== 'ZRET' &amp;&amp; 
									${UI>/IsInternalUser} === true
							}"/>
			</m:OverflowToolbar>
		</footer>
	</ObjectPageLayout>
</mvc:View>